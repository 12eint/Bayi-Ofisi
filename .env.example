# Bu dosyayı ".env" adıyla kopyala ve doldur. .env dosyasını kimseyle paylaşma.

# Claude API anahtarı (https://platform.claude.com). Boşsa ofis "Deneme" modunda (kural tabanlı) çalışır.
ANTHROPIC_API_KEY=

# İsteğe bağlı: API-Football (api-sports.io) – takım formu ve sakatlık verisi için. Ücretsiz katman: günde 100 istek.
API_FOOTBALL_KEY=

# Sunucu portu (yalnızca bu bilgisayardan erişilir: 127.0.0.1)
PORT=3000
