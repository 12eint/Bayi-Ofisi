{
  "name": "bayi-ofisi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bayi Ofisi - cok agent'li iddaa kupon ONERI sistemi (yalnizca oneri uretir)",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "setup": "npm install && npx playwright install chromium",
    "bulten:cek": "node --disable-warning=ExperimentalWarning scripts/fetch-bulletin.js",
    "bulten:kaydet": "node --disable-warning=ExperimentalWarning scripts/snapshot.js",
    "bulten:ayristir": "node --disable-warning=ExperimentalWarning scripts/parse-snapshot.js",
    "ofis": "node --disable-warning=ExperimentalWarning scripts/office-cli.js",
    "agents:sync": "node scripts/sync-agents.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.332",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "html2canvas": "^1.4.1",
    "playwright": "^1.65.1",
    "three": "^0.170.0",
    "zod": "^4.6.7"
  }
}
